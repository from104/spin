# 작업용 스크래치
.scratch/

# 구글 OAuth 클라이언트 원문(웹·데스크톱 client_secret). 디렉터리째 막는다.
# ⚠️ 2026-09-05 감사: 옛 패턴 `client_secret_*.apps.googleusercontent.com.json` 은 파일명
# 중간의 공백(`… .com web.json`) 때문에 두 파일을 놓쳐 75f89ab 부터 추적되고 있었다.
secrets/
client_secret_*

# 앱이 내보낸 백업 파일 — 기현님의 실제 드릴·세션·명단 데이터다.
# 저장소 루트에 놓고 작업하는 일이 잦아서, `git add -A` 한 번에 개인 데이터가
# 커밋되는 것을 막는다.
# 이름은 `backupFileName()` 이 짓는다 — `SPIN_backup_YYYYMMDD.spin.backup.json`
# (`src/storage/files.ts` 의 확장자 표, `ExportSheet.test.tsx` 가 형식을 붙잡는다).
*.spin.backup.json

# SEO C2 — 프리렌더가 쓰는 중간 SSR 산출물(scripts/prerender.mjs 가 읽고 버린다).
.seo-build/

# 공유 링크 백엔드가 쌓는 암호문(server/share, 기본 SHARE_DATA_DIR=./data/share).
# ⚠️ 이용자가 올린 드릴이다 — 열쇠가 없어 우리도 못 읽지만, 못 읽는다고 커밋해도 되는 것은
# 아니다. 디렉터리째 막는다.
/data/
