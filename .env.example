# 앱 환경변수 — 이 파일을 `.env.local` 로 복사해 값을 채우십시오 (.env.local 은 커밋되지 않습니다).
# 셋 다 없어도 앱은 돕니다. 없으면 구글 드라이브 동기화 기능만 꺼집니다.
# 구글 OAuth 클라이언트는 각자 Google Cloud Console 에서 직접 발급해야 합니다 —
# 이 저장소는 클라이언트를 제공하지 않습니다.

# 웹용 OAuth 클라이언트 ID ("웹 애플리케이션" 유형).
# 승인된 자바스크립트 원본에 개발 주소(http://localhost:5173)와 배포 주소를 등록하십시오.
VITE_GOOGLE_CLIENT_ID=

# 데스크톱(Tauri)용 OAuth 클라이언트 ("데스크톱 앱" 유형 — 웹용으로는 이 흐름이 안 됩니다).
# `SPIN_DESKTOP_` 접두어는 Tauri 빌드에만 주입됩니다. 웹 빌드(`npm run build`)에는 실리지
# 않습니다 — vite.config.ts 의 envPrefix 게이팅. 자세한 배경은 docs/DEVELOPMENT.md 참조.
SPIN_DESKTOP_GOOGLE_CLIENT_ID=
SPIN_DESKTOP_GOOGLE_CLIENT_SECRET=

# 데스크톱 앱이 공유 링크를 만들 때 쓰는 웹앱 공개 출처. 데스크톱은 출처가 tauri://localhost 라
# 상대 경로 /api/share 가 닿지 않고 링크도 열 수 없으므로 여기 적은 도메인의 /api/share 를 부르고
# 링크도 이 도메인으로 만듭니다. 비우면 데스크톱에서 링크 공유가 되지 않습니다(다른 기능은 무관).
SPIN_DESKTOP_WEB_ORIGIN=

# ── 선택 ──────────────────────────────────────────────────────────────────────────
# 공유 링크 백엔드 주소. 비우면 같은 출처의 /api/share 를 씁니다(운영 구성).
#VITE_SHARE_API_BASE=
