# 배포 대상 — 이 파일을 `.env.deploy` 로 복사해 값을 채우십시오 (.env.deploy 는 커밋되지 않습니다).
# scripts/deploy-aws.sh(웹) · scripts/deploy-share.sh(공유 링크 백엔드)가 읽습니다.
# 셋 다 필수이며, 비어 있으면 스크립트가 전송 전에 멈춥니다.

# 배포 서버 호스트명 또는 IP
SPIN_AWS_HOST=
# SSH 사용자명
SPIN_AWS_USER=
# SSH 개인키 파일 경로 (권한 600/400)
SPIN_AWS_PEM=

# ── 아래는 선택 — 비우면 괄호 안 기본값을 씁니다 ──────────────────────────────────
# 웹 정적 파일을 놓을 원격 디렉터리 (/opt/bitnami/apache2/spin-htdocs)
#SPIN_AWS_PATH=
# 배포 후 안내에 찍히는 공개 주소 (https://spin.atit.app)
#SPIN_AWS_URL=
# 공유 링크 백엔드 설치 경로 (/opt/spin-share)
#SPIN_SHARE_PATH=
# 공유 링크 헬스체크 주소 (https://spin.atit.app/api/share/healthz)
#SPIN_SHARE_URL=
# 원격 Apache vhost 디렉터리 (/opt/bitnami/apache2/conf/vhosts)
#SPIN_AWS_VHOST_DIR=
# 원격 Node 실행 파일 경로 — systemd 유닛의 ExecStart 와 같아야 합니다 (/opt/bitnami/node/bin/node)
#SPIN_AWS_NODE=
